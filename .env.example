# Только имена переменных. Реальные значения не коммитим.
# На хостинге секреты хранятся вне публичной папки.
# Vercel (стейджинг): не задавать SMTP_*, TELEGRAM_*, MAX_* и PUBLIC_LEAD_ENDPOINT.
# См. docs/architecture/deploy.md

# URL сайта для canonical, sitemap, robots (прод на Beget).
# На Vercel при сборке подставляется VERCEL_URL, если не задано.
PUBLIC_SITE_URL=

# Индексация: на проде true; на Vercel staging — false (см. vercel.json).
PUBLIC_INDEXING_ENABLED=false

# Клиентский endpoint заявок (например /api/lead). Пусто = stub, без сети.
# На Vercel staging оставлять пустым.
PUBLIC_LEAD_ENDPOINT=

# Почта (только прод / Beget)
LEAD_NOTIFY_EMAIL=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Max (только прод / Beget)
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# Telegram (только прод / Beget)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Адрес ретранслятора, если Telegram недоступен напрямую (необязательно)
TELEGRAM_RELAY_URL=

# Клиентская часть (видна всем, секретов здесь быть не должно)
PUBLIC_CALLIBRI_ENABLED=false
