---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import DirectionHero from '../components/DirectionHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Materials from '../components/Materials.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CTABand from '../components/CTABand.astro';
import CaseGrid from '../components/CaseGrid.astro';
import AboutSection from '../components/AboutSection.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm';
import Footer from '../components/Footer.astro';
import {
  about,
  beforeAfter,
  cta,
  faq,
  hero,
  jsonLdService,
  materials,
  pageMeta,
  services,
  trust,
} from '../data/blagoustrojstvo';
import {
  afterPhoto,
  beforePhoto,
  caseGroups,
  heroPhoto,
  reviewShots,
} from '../data/blagoustrojstvo-media';
---

<BaseLayout title={pageMeta.title} description={pageMeta.description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLdService)}
  />
  <div class="page-shell">
    <Header
      links={[
        { href: '#trust', label: 'Доверие' },
        { href: '#services', label: 'Услуги' },
        { href: '#materials', label: 'Материалы' },
        { href: '#before-after', label: 'До и после' },
        { href: '#visit', label: 'Выезд' },
        { href: '#cases', label: 'Работы' },
        { href: '#about', label: 'Компания' },
        { href: '#reviews', label: 'Отзывы' },
        { href: '#faq', label: 'Вопросы' },
      ]}
    />
    <main>
      <DirectionHero
        title={hero.title}
        support={hero.support}
        ctaLabel={hero.ctaLabel}
        ctaHref={hero.ctaHref}
        chips={hero.chips}
        photo={heroPhoto}
        photoAlt={hero.photoAlt}
        transitionName="dir-landscaping"
      />
      <TrustStrip items={[...trust]} />
      <ServiceGrid items={services} />
      <Materials title={materials.title} text={materials.text} />
      <BeforeAfter
        before={beforePhoto}
        after={afterPhoto}
        beforeAlt={beforeAfter.beforeAlt}
        afterAlt={beforeAfter.afterAlt}
      />
      <CTABand
        title={cta.title}
        text={cta.text}
        href={cta.href}
        ctaLabel={cta.ctaLabel}
      />
      <CaseGrid groups={caseGroups} />
      <AboutSection text={about.text} metrics={about.metrics} />
      <Testimonials items={reviewShots} />
      <FAQ items={faq} />
      <LeadForm client:load />
    </main>
    <Footer />
  </div>
</BaseLayout>
