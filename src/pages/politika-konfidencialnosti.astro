---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PolicyContent from '../components/PolicyContent.astro';

const title = 'Политика конфиденциальности — Монолит';
const description =
  'Политика обработки персональных данных ИП Ерамасова В.Н.: состав данных, права субъектов и порядок отзыва согласия.';

const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Политика конфиденциальности',
  description,
  inLanguage: 'ru-RU',
  url: canonical.href,
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="page-shell">
    <Header />
    <main class="section">
      <div class="container">
        <PolicyContent />
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
