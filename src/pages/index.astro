---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroIntro from '../components/HeroIntro.astro';
import DirectionChooser from '../components/DirectionChooser';
import TrustStrip from '../components/TrustStrip.astro';
import CTABand from '../components/CTABand.astro';
import LeadForm from '../components/LeadForm';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Монолит — благоустройство и ремонт квартир в Тюмени"
  description="Ландшафтное благоустройство участка и ремонт квартир под ключ в Тюмени. Бесплатный выезд и расчёт стоимости."
>
  <div class="page-shell">
    <Header
      links={[
        { href: '#directions', label: 'Направления' },
        { href: '#trust', label: 'Доверие' },
        { href: '#visit', label: 'Выезд' },
      ]}
    />
    <main>
      <HeroIntro />
      <DirectionChooser client:load />
      <TrustStrip />
      <CTABand />
      <LeadForm client:load />
    </main>
    <Footer />
  </div>
</BaseLayout>
