---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PhotoHero from '../components/PhotoHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import PackageBand from '../components/PackageBand.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CaseGrid from '../components/CaseGrid.astro';
import AboutSection from '../components/AboutSection.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm';
import Footer from '../components/Footer.astro';
import {
  about,
  cases,
  faq,
  hero,
  jsonLdService,
  packageOffer,
  pageMeta,
  services,
  trust,
} from '../data/remont-kvartir';
---

<BaseLayout title={pageMeta.title} description={pageMeta.description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLdService)}
  />
  <div class="page-shell">
    <Header
      secondaryHref="/blagoustrojstvo"
      secondaryLabel="Благоустройство"
    />
    <main>
      <PhotoHero
        title={hero.title}
        support={hero.support}
        ctaLabel={hero.ctaLabel}
        ctaHref={hero.ctaHref}
        photoAlt={hero.photoAlt}
        transitionName="dir-renovation"
      />
      <TrustStrip items={[...trust]} />
      <PackageBand
        title={packageOffer.title}
        eyebrow={packageOffer.eyebrow}
        items={packageOffer.items}
        priceFrom={packageOffer.priceFrom}
        ctaLabel={packageOffer.ctaLabel}
        ctaHref={packageOffer.ctaHref}
      />
      <ServiceGrid items={services} />
      <CaseGrid
        items={cases}
        variant="dark"
        showActions
        viewLabel="Смотреть"
        leadLabel="Оставить заявку"
        leadHref="#lead"
      />
      <AboutSection
        title={about.title}
        text={about.text}
        metrics={about.metrics}
      />
      <FAQ items={faq} />
      <LeadForm
        client:load
        image={{
          src: '/images/jpg/дизайн-3.jpg',
          width: 1680,
          height: 1120,
        }}
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
