---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PhotoHero from '../components/PhotoHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import DesignBand from '../components/DesignBand.astro';
import PackageBand from '../components/PackageBand.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CaseGrid from '../components/CaseGrid.astro';
import AboutSection from '../components/AboutSection.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm';
import Footer from '../components/Footer.astro';
import {
  about,
  design,
  faq,
  hero,
  jsonLdService,
  packageOffer,
  pageMeta,
  services,
  trust,
} from '../data/remont-kvartir';
import { caseGroups } from '../data/remont-kvartir-media';

const headerLinks = [
  { href: '#trust', label: 'Доверие' },
  { href: '#design', label: 'Дизайн' },
  { href: '#package', label: 'Пакет' },
  { href: '#services', label: 'Услуги' },
  ...(caseGroups.length > 0 ? [{ href: '#cases', label: 'Работы' }] : []),
  { href: '#about', label: 'Компания' },
  { href: '#faq', label: 'Вопросы' },
];
---

<BaseLayout title={pageMeta.title} description={pageMeta.description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLdService)}
  />
  <div class="page-shell">
    <Header links={headerLinks} />
    <main>
      <PhotoHero
        title={hero.title}
        support={hero.support}
        ctaLabel={hero.ctaLabel}
        ctaHref={hero.ctaHref}
        photo={hero.photo}
        transitionName="dir-renovation"
      />
      <TrustStrip items={[...trust]} />
      <DesignBand
        eyebrow={design.eyebrow}
        title={design.title}
        text={design.text}
        photoAlt={design.photo.alt}
        ctaLabel={design.ctaLabel}
        ctaHref={design.ctaHref}
      />
      <PackageBand
        title={packageOffer.title}
        eyebrow={packageOffer.eyebrow}
        items={packageOffer.items}
        priceFrom={packageOffer.priceFrom}
        photoAlt={packageOffer.photoAlt}
        ctaLabel={packageOffer.ctaLabel}
        ctaHref={packageOffer.ctaHref}
      />
      <ServiceGrid items={services} />
      {
        caseGroups.length > 0 && (
          <CaseGrid groups={caseGroups} variant="dark" />
        )
      }
      <AboutSection
        title={about.title}
        text={about.text}
        metrics={about.metrics}
      />
      <FAQ items={faq} />
      <LeadForm
        client:load
        image={{
          src: '/images/jpg/дизайн-3.jpg',
          width: 1680,
          height: 1120,
        }}
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
