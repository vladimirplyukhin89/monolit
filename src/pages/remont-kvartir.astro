---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Ремонт квартир под ключ в Тюмени — Монолит"
  description="Ремонт квартир под ключ в Тюмени. Страница в подготовке."
>
  <div
    class="page-shell"
    data-direction="renovation"
    style="background-color: var(--color-ambient-renovation)"
  >
    <Header />
    <main class="section">
      <div class="container stub">
        <h1>Ремонт квартир</h1>
        <p>
          Страница в работе. Контент — в
          <code>docs/content/remont-kvartir.md</code>,
          фото — в
          <code>docs/content/media/remont-kvartir/</code>.
        </p>
        <p><a href="/">На главную</a></p>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .stub {
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .stub h1 {
    margin-top: 0;
    font-size: var(--font-size-2xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .stub code {
    font-size: 0.9em;
  }
</style>
