---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import CookiePolicyContent from '../components/CookiePolicyContent.astro';

const title = 'Политика обработки cookie — Монолит';
const description =
  'Как сайт Монолит использует файлы cookie: категории, согласие пользователя и управление в браузере.';

const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Политика обработки персональных данных в отношении файлов cookie',
  description,
  inLanguage: 'ru-RU',
  url: canonical.href,
  dateModified: '2026-11-17',
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="page-shell">
    <Header />
    <Breadcrumbs current="Политика cookie" />
    <main class="section">
      <div class="container">
        <CookiePolicyContent />
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
