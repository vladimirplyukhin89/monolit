---
import { Image } from 'astro:assets';
import photo from '../../public/images/png/объект-3.png';

interface Props {
  eyebrow?: string;
  title: string;
  items: readonly string[];
}

const { eyebrow = 'Материалы', title, items } = Astro.props;
---

<section id="materials" class="materials section" aria-labelledby="materials-title">
  <div class="container">
    <div class="materials__band reveal glow">
      <div class="materials__copy">
        <p class="eyebrow eyebrow--on-primary">{eyebrow}</p>
        <h2 id="materials-title" class="materials__title">{title}</h2>
        <ol class="materials__list">
          {items.map((item) => (
            <li class="materials__item">{item}</li>
          ))}
        </ol>
      </div>
      <div class="materials__media">
        <Image
          src={photo}
          alt="Тротуарная плитка, щебень и мешки с песком на поддоне у дома"
          widths={[480, 768, 1200]}
          sizes="(min-width: 768px) 40vw, 100vw"
          loading="lazy"
          class="materials__photo"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .materials__band {
    display: grid;
    overflow: hidden;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    border-radius: var(--radius-xl);
  }

  .materials__copy {
    display: grid;
    align-content: center;
    gap: var(--space-6);
    padding: var(--space-8);
  }

  .materials__title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .materials__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
    counter-reset: materials;
  }

  .materials__list li {
    counter-increment: materials;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, white 28%, transparent);
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: var(--line-height-tight);
  }

  :global(html.has-motion) .materials__item {
    opacity: 0;
  }

  .materials__list li::before {
    content: counter(materials);
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    border-radius: var(--radius-full);
    background: var(--color-bg-inverse);
    color: var(--color-on-inverse);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .materials__media {
    position: relative;
    min-height: 18rem;
  }

  .materials__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  @media (min-width: 768px) {
    .materials__list li {
      padding: var(--space-4);
    }

    .materials__list li::before {
      width: 2.25rem;
      height: 2.25rem;
      font-size: var(--font-size-base);
    }

    .materials__band {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    }

    .materials__copy {
      padding: var(--space-12);
    }

    .materials__media {
      min-height: 100%;
    }
  }
</style>
