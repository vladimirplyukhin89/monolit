---
import Logo from './Logo.astro';

interface ServiceItem {
  title: string;
  summary?: string;
  points?: readonly string[];
  priceFrom: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items: ServiceItem[];
}

const { eyebrow = 'Услуги', title = 'Наши услуги', items } = Astro.props;
---

<section id="services" class="services section" aria-labelledby="services-title">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="services-title" class="services__title">{title}</h2>
    <ul class="services__list">
      {
        items.map((item) => (
          <li class="services__card reveal glow">
            <span class="services__card-logo" aria-hidden="true">
              <Logo accent={false} />
            </span>
            <h3 class="services__card-title">{item.title}</h3>
            <div class="services__card-body">
              {
                item.points && item.points.length > 0 ? (
                  <ul class="services__points">
                    {item.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                ) : (
                  item.summary && <p class="services__card-summary">{item.summary}</p>
                )
              }
            </div>
            <p class="services__card-price">
              <span class="visually-hidden">{item.priceFrom}</span>
              <span class="services__card-price-figure" aria-hidden="true">
                {item.priceFrom}
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__title {
    margin: 0 0 var(--space-8);
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .services__card {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    padding-bottom: calc(var(--space-6) + var(--space-12));
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-2);
  }

  .services__card-logo {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    color: color-mix(in srgb, var(--color-text) 18%, transparent);
    pointer-events: none;
  }

  .services__card-logo :global(svg) {
    display: block;
    width: 8rem;
    height: auto;
  }

  .services__card-title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: var(--line-height-tight);
  }

  .services__card-summary {
    margin: 0;
    color: var(--color-text-muted);
  }

  .services__points {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
  }

  .services__points li {
    position: relative;
    padding-left: var(--space-4);
  }

  .services__points li::before {
    content: '';
    position: absolute;
    top: 0.5lh;
    left: 0;
    width: 0.4em;
    height: 0.4em;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    transform: translateY(-50%);
    animation: services-point-pulse calc(var(--duration-slow) * 5) var(--ease-in-out) infinite;
  }

  .services__points li + li {
    margin-top: var(--space-1);
  }

  @keyframes services-point-pulse {
    0%,
    100% {
      transform: translateY(-50%) scale(1);
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 50%, transparent);
    }

    50% {
      transform: translateY(-50%) scale(1.2);
      box-shadow: 0 0 0 0.28em color-mix(in srgb, var(--color-primary) 0%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services__points li::before {
      animation: none;
    }
  }

  .services__card-price {
    margin: 0;
    align-self: end;
    font-weight: 600;
    line-height: var(--line-height-tight);
    color: var(--color-text);
  }

  .services__card-price-figure {
    font-variant-numeric: tabular-nums;
  }

  /* До скрипта reveal цифра не мелькает финальным значением */
  :global(html.has-motion) .services__card-price-figure {
    opacity: 0;
  }

  @media (min-width: 768px) {
    .services__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    .services__card-logo :global(svg) {
      width: 12rem;
    }
  }

  @media (min-width: 1024px) {
    .services__list {
      grid-template-columns: repeat(3, 1fr);
    }

    .services__card-logo :global(svg) {
      width: 14rem;
    }
  }
</style>
