<button
  type="button"
  class="to-top"
  data-to-top
  aria-label="Наверх"
  aria-hidden="true"
  tabindex="-1"
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M6 14.5 12 8.5l6 6"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-to-top]');

  if (button) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    const sync = () => {
      frame = 0;
      const visible = window.scrollY > window.innerHeight * 0.45;
      button.classList.toggle('is-visible', visible);
      button.setAttribute('aria-hidden', visible ? 'false' : 'true');
      button.tabIndex = visible ? 0 : -1;
    };

    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(sync);
    };

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: motion.matches ? 'auto' : 'smooth' });
      const main = document.querySelector('main');
      if (main instanceof HTMLElement) {
        if (!main.hasAttribute('tabindex')) main.tabIndex = -1;
        main.focus({ preventScroll: true });
      }
    });

    sync();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  }
</script>

<style>
  .to-top {
    position: fixed;
    z-index: 20;
    left: var(--space-4);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    display: grid;
    place-items: center;
    width: var(--space-12);
    height: var(--space-12);
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-text-muted);
    color: var(--color-bg);
    box-shadow:
      0 0 0 var(--space-1) var(--color-surface),
      0 var(--space-2) var(--space-4) var(--shadow-color);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(var(--space-2));
    transition:
      opacity var(--duration-base) var(--ease-out),
      visibility var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  .to-top:hover {
    background: var(--color-primary-hover);
    color: var(--color-primary-contrast);
  }

  .to-top:active,
  .to-top.is-visible:active {
    background: var(--color-primary-active);
    color: var(--color-primary-contrast);
    transform: scale(var(--press-scale));
  }

  .to-top svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  :global(html.nav-open) .to-top {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .to-top {
      right: var(--space-6);
      bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    }
  }

  @media print {
    .to-top {
      display: none;
    }
  }
</style>
