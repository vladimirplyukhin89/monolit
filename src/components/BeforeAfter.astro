---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title?: string;
  before?: ImageMetadata;
  after?: ImageMetadata;
  beforeAlt?: string;
  afterAlt?: string;
}

const {
  eyebrow = 'До и после',
  title = 'Как меняется участок после благоустройства',
  before,
  after,
  beforeAlt = 'Участок до работ',
  afterAlt = 'Участок после работ',
} = Astro.props;
---

<section id="before-after" class="ba section" aria-labelledby="ba-title">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="ba-title" class="ba__title">{title}</h2>
    <div class="ba__pair">
      <figure class="ba__frame reveal">
        {
          before ? (
            <Image
              src={before}
              alt={beforeAlt}
              widths={[480, 800]}
              sizes="(min-width: 768px) 46vw, 100vw"
              loading="lazy"
              class="ba__photo"
            />
          ) : (
            <div class="ba__placeholder" role="img" aria-label={beforeAlt}>
              <span>До</span>
            </div>
          )
        }
        <figcaption>До</figcaption>
      </figure>
      <figure class="ba__frame reveal">
        {
          after ? (
            <Image
              src={after}
              alt={afterAlt}
              widths={[480, 800]}
              sizes="(min-width: 768px) 46vw, 100vw"
              loading="lazy"
              class="ba__photo"
            />
          ) : (
            <div class="ba__placeholder" role="img" aria-label={afterAlt}>
              <span>После</span>
            </div>
          )
        }
        <figcaption>После</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .ba__title {
    margin: 0 0 var(--space-8);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .ba__pair {
    display: grid;
    gap: var(--space-4);
  }

  .ba__frame {
    margin: 0;
  }

  .ba__photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    object-fit: cover;
  }

  .ba__placeholder {
    min-height: 12rem;
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .ba__frame figcaption {
    margin-top: var(--space-2);
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .ba__pair {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .ba__placeholder {
      min-height: 16rem;
    }
  }
</style>
