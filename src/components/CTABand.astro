---
interface Props {
  title?: string;
  text?: string;
  href?: string;
  ctaLabel?: string;
}

const {
  title = 'Закажите бесплатный выезд специалиста и получите скидку 5%',
  text = 'Специалист приедет в удобное время, сделает замеры и подготовит предварительную смету.',
  href = '#lead',
  ctaLabel = 'Оставить заявку',
} = Astro.props;
---

<section class="cta section">
  <div class="container">
    <div class="cta__panel">
      <h2 class="cta__title">{title}</h2>
      <p class="cta__text">{text}</p>
      <a class="cta__button" href={href} data-lead-dialog>{ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  @property --cta-border-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .cta__panel {
    --cta-border-width: 2px;
    --cta-border-spin: 4s;

    position: relative;
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-glow);
  }

  .cta__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: var(--cta-border-width);
    background: conic-gradient(
      from var(--cta-border-angle),
      transparent 0%,
      transparent 32%,
      color-mix(in oklch, var(--color-primary), black 18%) 42%,
      var(--color-primary) 50%,
      color-mix(in oklch, var(--color-primary), white 28%) 58%,
      transparent 68%,
      transparent 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    animation: cta-border-spin var(--cta-border-spin) linear infinite;
  }

  @keyframes cta-border-spin {
    to {
      --cta-border-angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__panel::before {
      animation: none;
      --cta-border-angle: 135deg;
    }
  }

  .cta__title {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .cta__text {
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
    max-width: 36rem;
  }

  .cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    text-decoration: none;
    font-weight: 600;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .cta__button:hover {
    background: var(--color-primary-hover);
  }

  .cta__button:active {
    background: var(--color-primary-active);
    transform: scale(var(--press-scale));
  }
</style>
