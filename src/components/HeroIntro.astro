---
import HeroSlider, { type HeroSlide } from './HeroSlider';

interface Props {
  chips?: readonly string[];
  ctaLabel?: string;
  ctaHref?: string;
  note?: string;
  slides?: readonly HeroSlide[];
}

const slidesDefault: readonly HeroSlide[] = [
  {
    src: '/images/png/объект-1.png',
    alt: 'Двор у кирпичного дома: мощение ёлочкой, кашпо и живая изгородь',
    width: 1024,
    height: 1024,
    objectPosition: 'center 36%',
  },
  {
    src: '/images/png/объект-2.png',
    alt: 'Кирпичный дом с гаражом: подъезд из брусчатки ёлочкой, бордюр и кустарники',
    width: 1024,
    height: 1024,
    objectPosition: 'center 60%',
  },
  {
    src: '/images/webp/дизайн-1.webp',
    alt: 'Гостиная-столовая: диван, обеденный стол у окна и подвесные светильники',
    width: 1680,
    height: 1121,
  },
];

const {
  chips = [
    'Асфальтирование',
    'Брусчатка',
    'Водоотведение',
    'Фундаменты и отмостки',
    'Тротуарная плитка',
  ],
  ctaLabel = 'Оставить заявку',
  ctaHref = '#lead',
  note = 'Бесплатный выезд специалиста и расчет стоимости',
  slides = slidesDefault,
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__plate">
      <div class="hero__media">
        <HeroSlider client:load slides={slides} />
      </div>
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title">
          Ландшафтное <span class="hero__accent">благоустройство участка</span> и <span class="hero__accent">ремонт квартир</span> под ключ в Тюмени
        </h1>
        <ul class="hero__chips" aria-label="Услуги">
          {chips.map((chip) => (
            <li>{chip}</li>
          ))}
        </ul>
        <div class="hero__actions">
          <a class="hero__cta" href={ctaHref} data-lead-dialog>{ctaLabel}</a>
          <p class="hero__note">{note}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-8);
  }

  .hero__plate {
    position: relative;
    overflow: hidden;
    min-height: 22rem;
    border-radius: var(--radius-xl);
    background: var(--color-bg-inverse);
    container-type: inline-size;
    container-name: hero;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(astro-island) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    max-width: 36rem;
    padding: var(--space-6) var(--space-4) var(--space-12);
    pointer-events: none;
  }

  .hero__title {
    margin: 0 0 var(--space-4);
    color: var(--color-on-inverse);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
  }

  .hero__accent {
    color: var(--color-primary);
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .hero__chips li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-on-inverse) 55%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-on-inverse);
    font-size: var(--font-size-base);
    font-weight: 500;
    background-image: linear-gradient(
      105deg,
      transparent 28%,
      color-mix(in srgb, var(--color-primary) 18%, transparent) 50%,
      transparent 72%
    );
    background-size: 320% 100%;
    background-position: 100% 0;
    animation: hero-chip-sheen calc(var(--duration-slow) * 14) linear infinite;
  }

  .hero__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: var(--space-3);
  }

  .hero__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    text-decoration: none;
    font-weight: 500;
    pointer-events: auto;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .hero__cta:hover {
    background: var(--color-primary-hover);
  }

  .hero__cta:active {
    background: var(--color-primary-active);
    transform: scale(var(--press-scale));
  }

  .hero__note {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.5rem;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    text-align: center;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-primary) 18%, var(--color-bg));
    color: color-mix(in oklch, var(--color-primary) 55%, var(--color-text));
    font-size: 0.875rem;
    font-weight: 300;
    line-height: var(--line-height-tight);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-8);
    }

    .hero__plate {
      min-height: 30rem;
    }

    .hero__copy {
      padding: var(--space-8) var(--space-8) var(--space-12);
    }

    .hero__title {
      width: 50cqi;
      font-size: calc(var(--font-size-2xl) * 1.35);
    }
  }

  @keyframes hero-chip-sheen {
    0% {
      background-position: 100% 0;
    }

    78% {
      background-position: -100% 0;
    }

    100% {
      background-position: -100% 0;
    }
  }
</style>
