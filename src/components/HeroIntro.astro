---
interface Props {
  brand?: string;
  offer?: string;
  support?: string;
  photoAlt?: string;
}

const {
  brand = 'Монолит',
  offer = 'Ландшафтное благоустройство и ремонт квартир под ключ в Тюмени',
  support = 'Бесплатный выезд специалиста и расчёт стоимости',
  photoAlt = 'Фото объектов',
} = Astro.props;
---

<section class="hero section">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__brand">{brand}</p>
      <h1 class="hero__title">{offer}</h1>
      <p class="hero__support">{support}</p>
    </div>
    <div class="hero__media" role="img" aria-label={photoAlt}>
      <span class="hero__media-label">Фото объектов</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-8);
    text-align: left;
  }

  .hero__brand {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-base);
    font-weight: 500;
    line-height: var(--line-height-base);
    color: var(--color-text-muted);
  }

  .hero__title {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .hero__support {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .hero__media {
    min-height: 14rem;
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    display: grid;
    place-items: center;
  }

  .hero__media-label {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .hero__grid {
      grid-template-columns: 1.15fr 1fr;
      align-items: center;
      gap: var(--space-12);
    }

    .hero__title {
      font-size: var(--font-size-2xl);
    }

    .hero__media {
      min-height: 22rem;
    }
  }
</style>
