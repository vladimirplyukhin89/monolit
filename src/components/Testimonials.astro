---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhotoSlider, { type PhotoSlide } from './PhotoSlider';

interface Shot {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items: readonly Shot[];
}

const { eyebrow = 'Отзывы', title = 'Что говорят наши клиенты', items } = Astro.props;

const REVIEW_SIZES = '(min-width: 768px) 46vw, 100vw';

function dimension(value: unknown, fallback: number): number {
  const n = typeof value === 'number' ? value : Number(value);
  return Number.isFinite(n) && n > 0 ? n : fallback;
}

const slides: PhotoSlide[] = await Promise.all(
  items.map(async (item) => {
    const image = await getImage({
      src: item.src,
      widths: [360, 640],
      sizes: REVIEW_SIZES,
    });
    return {
      src: image.src,
      srcSet: image.srcSet.attribute,
      sizes: REVIEW_SIZES,
      width: dimension(image.attributes.width, item.src.width),
      height: dimension(image.attributes.height, item.src.height),
      alt: item.alt,
    };
  }),
);
---

<section id="reviews" class="reviews section" aria-labelledby="reviews-title">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="reviews-title" class="reviews__title">{title}</h2>
    <PhotoSlider client:visible slides={slides} variant="snap" label="Скриншоты отзывов" />
  </div>
</section>

<style>
  .reviews__title {
    margin: 0 0 var(--space-8);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }
</style>
