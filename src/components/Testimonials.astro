---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Shot {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items: readonly Shot[];
}

const { eyebrow = 'Отзывы', title = 'Что говорят наши клиенты', items } = Astro.props;
---

<section id="reviews" class="reviews section" aria-labelledby="reviews-title">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="reviews-title" class="reviews__title">{title}</h2>
    <ul class="reviews__list">
      {
        items.map((item) => (
          <li class="reviews__item reveal">
            <Image
              src={item.src}
              alt={item.alt}
              widths={[360, 640]}
              sizes="(min-width: 768px) 46vw, 100vw"
              loading="lazy"
              class="reviews__shot"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews__title {
    margin: 0 0 var(--space-8);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .reviews__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .reviews__item {
    margin: 0;
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--space-3);
  }

  .reviews__shot {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 768px) {
    .reviews__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
</style>
