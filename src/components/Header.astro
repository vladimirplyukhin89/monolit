---
import LeadDialog from './LeadDialog.astro';
import Logo from './Logo.astro';
import MobileNav, { type HeaderLink } from './MobileNav';
import ThemeToggle from './ThemeToggle';

interface Props {
  phone?: string;
  phoneHref?: string;
  links?: HeaderLink[];
}

const {
  phone = '8 (919) 950-77-22',
  phoneHref = 'tel:+79199507722',
  links = [],
} = Astro.props;

/** Адреса появятся позже. Пустая строка — иконка без перехода. */
const telegramHref = '';
const maxHref = '';

const directionLinks: HeaderLink[] = [
  { href: '/blagoustrojstvo', label: 'Благоустройство' },
  { href: '/remont-kvartir', label: 'Ремонт квартир' },
];

const pageLinks: HeaderLink[] = [
  ...directionLinks,
  { href: '/politika-konfidencialnosti', label: 'Политика конфиденциальности' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href="/" aria-label="Монолит">
      <Logo />
    </a>

    <div class="header__actions">
      <nav class="header__pages" aria-label="Страницы">
        {
          directionLinks.map((item) => (
            <a
              class="header__page"
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle client:load />

      <div class="header__contacts">
        <a
          class="header__social"
          href={maxHref || '#'}
          aria-label="Max"
          aria-disabled={maxHref ? undefined : 'true'}
          onclick={maxHref ? undefined : 'event.preventDefault()'}
        >
          <img src="/icons/max.svg" width="20" height="20" alt="" />
        </a>
        <a
          class="header__social"
          href={telegramHref || '#'}
          aria-label="Telegram"
          aria-disabled={telegramHref ? undefined : 'true'}
          onclick={telegramHref ? undefined : 'event.preventDefault()'}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path
              fill="#1d98dc"
              d="M21.5 4.3 3.8 11.1c-1.2.5-1.2 1.2-.2 1.5l4.5 1.4 1.7 5.3c.2.6.1.8.7.8.5 0 .7-.2 1-.5l2.4-2.3 5 3.7c.9.5 1.6.2 1.8-.9l3.3-15.5c.3-1.3-.5-1.9-1.5-1.3zM9.8 14.2l-.3 3.7-1.2-4 10.8-6.7-9.3 7z"
            ></path>
          </svg>
        </a>
        <a class="header__phone" href={phoneHref}>{phone}</a>
        <a class="header__phone-icon" href={phoneHref} aria-label={`Позвонить ${phone}`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
            ></path>
          </svg>
        </a>
      </div>

      <MobileNav
        client:load
        phone={phone}
        phoneHref={phoneHref}
        links={links}
        pageLinks={pageLinks}
      />

      <a class="header__cta" href="#lead" data-lead-dialog>Оставить заявку</a>
    </div>
  </div>
</header>

<LeadDialog />

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    view-transition-name: site-header;
    transition:
      background-color var(--theme-duration) ease,
      border-color var(--theme-duration) ease;
  }

  :global(html.nav-open) .header {
    background: var(--color-bg);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    gap: var(--space-2);
  }

  .header__logo {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header__logo:hover {
    color: var(--color-primary);
  }

  .header__logo :global(svg) {
    display: block;
    height: 1.5rem;
    width: auto;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .header__pages {
    display: none;
    align-items: center;
    gap: var(--space-3);
  }

  .header__page {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header__page:hover,
  .header__page[aria-current='page'] {
    color: var(--color-primary);
  }

  .header__contacts {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__social,
  .header__phone-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    cursor: pointer;
  }

  .header__social:hover,
  .header__phone-icon:hover {
    background: var(--color-ghost-hover);
    color: var(--color-primary);
  }

  .header__social[aria-disabled='true'] {
    cursor: default;
  }

  .header__social svg,
  .header__social img,
  .header__phone-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .header__cta {
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .header__cta:hover {
    background: var(--color-primary-hover);
  }

  .header__cta:active {
    background: var(--color-primary-active);
    transform: scale(var(--press-scale));
  }

  .header__phone {
    display: none;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header__phone:hover {
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .header__inner {
      min-height: 4.25rem;
      gap: var(--space-4);
    }

    .header__logo :global(svg) {
      height: 2rem;
    }

    .header__actions {
      gap: var(--space-3);
    }

    .header__contacts {
      gap: var(--space-2);
    }

    .header__social,
    .header__phone-icon {
      width: 2.25rem;
      height: 2.25rem;
    }

    .header__phone {
      display: inline;
    }

    .header__phone-icon {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .header__actions {
      gap: var(--space-4);
    }

    .header__pages,
    .header__cta {
      display: flex;
    }
  }
</style>
