---
import CaseSlider from './CaseSlider';

interface CaseItem {
  title: string;
  category: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items: CaseItem[];
  variant?: 'light' | 'dark';
  showActions?: boolean;
  viewLabel?: string;
  leadLabel?: string;
  leadHref?: string;
}

const {
  eyebrow = 'Работы',
  title = 'Наши работы',
  items,
  variant = 'light',
  showActions = false,
  viewLabel = 'Смотреть',
  leadLabel = 'Оставить заявку',
  leadHref = '#lead',
} = Astro.props;

const isDark = variant === 'dark';
---

<section
  id="cases"
  class:list={['cases', 'section', isDark && 'cases--dark']}
  aria-labelledby="cases-title"
>
  <div class="container">
    <p class:list={['eyebrow', isDark && 'eyebrow--on-inverse']}>{eyebrow}</p>
    <h2 id="cases-title" class="cases__title">{title}</h2>
    <CaseSlider
      client:visible
      items={items}
      variant={variant}
      showActions={showActions}
      viewLabel={viewLabel}
      leadLabel={leadLabel}
      leadHref={leadHref}
    />
  </div>
</section>

<style>
  .cases--dark {
    background: var(--color-bg-inverse);
    color: var(--color-on-inverse);
  }

  .cases__title {
    margin: 0 0 var(--space-8);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }
</style>
