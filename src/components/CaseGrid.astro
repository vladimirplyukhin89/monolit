---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CaseSlider from './CaseSlider';
import CaseTabs, { type CaseTabGroup } from './CaseTabs';

interface CaseItem {
  title: string;
  category: string;
}

interface CasePhoto {
  src: ImageMetadata;
  alt: string;
}

interface CaseGroup {
  title: string;
  photos: readonly CasePhoto[];
}

interface Props {
  eyebrow?: string;
  title?: string;
  items?: CaseItem[];
  groups?: readonly CaseGroup[];
  variant?: 'light' | 'dark';
  showActions?: boolean;
  viewLabel?: string;
  leadLabel?: string;
  leadHref?: string;
}

const {
  eyebrow = 'Работы',
  title = 'Наши работы',
  items = [],
  groups = [],
  variant = 'light',
  showActions = false,
  viewLabel = 'Смотреть',
  leadLabel = 'Оставить заявку',
  leadHref = '#lead',
} = Astro.props;

const CASE_SIZES = '(min-width: 1024px) 50rem, (min-width: 768px) 70vw, 82vw';

function dimension(value: unknown, fallback: number): number {
  const n = typeof value === 'number' ? value : Number(value);
  return Number.isFinite(n) && n > 0 ? n : fallback;
}

const optimizedGroups: CaseTabGroup[] = await Promise.all(
  groups.map(async (group) => ({
    title: group.title,
    photos: await Promise.all(
      group.photos.map(async (photo) => {
        const image = await getImage({
          src: photo.src,
          widths: [480, 800, 1200],
          sizes: CASE_SIZES,
        });
        return {
          src: image.src,
          srcSet: image.srcSet.attribute,
          sizes: CASE_SIZES,
          width: dimension(image.attributes.width, photo.src.width),
          height: dimension(image.attributes.height, photo.src.height),
          alt: photo.alt,
        };
      }),
    ),
  })),
);

const isDark = variant === 'dark';
const hasGroups = optimizedGroups.length > 0;
---

<section
  id="cases"
  class:list={['cases', 'section', isDark && 'cases--dark']}
  aria-labelledby="cases-title"
>
  <div class="container">
    <p class:list={['eyebrow', isDark && 'eyebrow--on-inverse']}>{eyebrow}</p>
    <h2 id="cases-title" class="cases__title">{title}</h2>
    {
      hasGroups ? (
        <CaseTabs
          client:visible
          groups={optimizedGroups}
          tone={isDark ? 'inverse' : 'default'}
        />
      ) : (
        <CaseSlider
          client:visible
          items={items}
          variant={variant}
          showActions={showActions}
          viewLabel={viewLabel}
          leadLabel={leadLabel}
          leadHref={leadHref}
        />
      )
    }
  </div>
</section>

<style>
  .cases--dark {
    background: var(--color-bg-inverse);
    color: var(--color-on-inverse);
  }

  .cases__title {
    margin: 0 0 var(--space-8);
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }
</style>
