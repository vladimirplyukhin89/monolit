---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CaseSlider from './CaseSlider';

interface CaseItem {
  title: string;
  category: string;
}

interface CasePhoto {
  src: ImageMetadata;
  alt: string;
}

interface CaseGroup {
  title: string;
  photos: readonly CasePhoto[];
}

interface Props {
  eyebrow?: string;
  title?: string;
  items?: CaseItem[];
  groups?: readonly CaseGroup[];
  variant?: 'light' | 'dark';
  showActions?: boolean;
  viewLabel?: string;
  leadLabel?: string;
  leadHref?: string;
}

const {
  eyebrow = 'Работы',
  title = 'Наши работы',
  items = [],
  groups = [],
  variant = 'light',
  showActions = false,
  viewLabel = 'Смотреть',
  leadLabel = 'Оставить заявку',
  leadHref = '#lead',
} = Astro.props;

const isDark = variant === 'dark';
const hasGroups = groups.length > 0;
---

<section
  id="cases"
  class:list={['cases', 'section', isDark && 'cases--dark']}
  aria-labelledby="cases-title"
>
  <div class="container">
    <p class:list={['eyebrow', isDark && 'eyebrow--on-inverse']}>{eyebrow}</p>
    <h2 id="cases-title" class="cases__title">{title}</h2>
    {
      hasGroups ? (
        <div class="cases__groups">
          {groups.map((group) => (
            <div class="cases__group">
              <h3 class="cases__group-title">{group.title}</h3>
              <ul class="cases__photos">
                {group.photos.map((photo) => (
                  <li>
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      widths={[360, 640]}
                      sizes="(min-width: 1024px) 30vw, (min-width: 768px) 46vw, 100vw"
                      loading="lazy"
                      class="cases__photo"
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ) : (
        <CaseSlider
          client:visible
          items={items}
          variant={variant}
          showActions={showActions}
          viewLabel={viewLabel}
          leadLabel={leadLabel}
          leadHref={leadHref}
        />
      )
    }
  </div>
</section>

<style>
  .cases--dark {
    background: var(--color-bg-inverse);
    color: var(--color-on-inverse);
  }

  .cases__title {
    margin: 0 0 var(--space-8);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .cases__groups {
    display: grid;
    gap: var(--space-12);
  }

  .cases__group-title {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: var(--line-height-tight);
  }

  .cases__photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .cases__photo {
    width: 100%;
    height: 14rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 768px) {
    .cases__photos {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    .cases__photo {
      height: 16rem;
    }
  }

  @media (min-width: 1024px) {
    .cases__photos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
