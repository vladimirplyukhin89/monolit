---
interface Item {
  title: string;
  text: string;
}

interface Props {
  items?: Item[];
}

const {
  items = [
    {
      title: 'Понятная смета',
      text: 'Без скрытых платежей. Цена фиксируется до начала работ.',
    },
    {
      title: 'Сроки в договоре',
      text: 'Согласуем график и придерживаемся его.',
    },
    {
      title: 'Гарантия до 5 лет',
      text: 'Отвечаем за качество работ и материалов.',
    },
  ],
} = Astro.props;

function itemNumber(index: number): string {
  return String(index + 1).padStart(2, '0');
}
---

<section id="trust" class="trust section" aria-labelledby="trust-title">
  <div class="container">
    <p class="eyebrow">Доверие</p>
    <h2 id="trust-title" class="trust__title">Почему нам доверяют</h2>
    <ul class="trust__list">
      {
        items.map((item, index) => (
          <li
            class:list={[
              'trust__item',
              'reveal',
              'glow',
              index === 0 && 'trust__item--featured',
            ]}
          >
            <span class="trust__ghost" aria-hidden="true">
              {itemNumber(index)}
            </span>
            <p class="trust__num" aria-hidden="true">
              {itemNumber(index)}
            </p>
            <span class="trust__meter" aria-hidden="true">
              <span class="trust__meter-fill" />
            </span>
            <h3 class="trust__item-title">{item.title}</h3>
            <p class="trust__item-text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust__title {
    margin: 0 0 var(--space-8);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .trust__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .trust__item {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .trust__item--featured {
    background:
      radial-gradient(
        ellipse 80% 70% at 90% 10%,
        color-mix(in srgb, var(--color-primary) 18%, transparent),
        transparent 58%
      ),
      var(--color-bg);
  }

  .trust__ghost {
    position: absolute;
    top: calc(var(--space-4) * -1);
    right: var(--space-2);
    z-index: 0;
    font-size: calc(var(--font-size-2xl) * 2.6);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    color: color-mix(in srgb, var(--color-primary) 14%, transparent);
    pointer-events: none;
  }

  .trust__num,
  .trust__meter,
  .trust__item-title,
  .trust__item-text {
    position: relative;
    z-index: 1;
  }

  .trust__num {
    margin: 0;
    font-size: var(--font-size-base);
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1;
    color: var(--color-primary);
  }

  /* Яркость номера и водяного знака добирается в reveal.ts, когда карточка в экране */
  :global(html.has-motion) .trust__num,
  :global(html.has-motion) .trust__ghost {
    opacity: 0;
  }

  .trust__meter {
    display: block;
    width: var(--space-12);
    height: 0.125rem;
    margin-top: var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .trust__meter-fill {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(1);
    transform-origin: left center;
    background: var(--color-primary);
  }

  .trust__item-title {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: var(--line-height-tight);
  }

  .trust__item-text {
    margin: 0;
    color: var(--color-text-muted);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .trust__meter-fill {
        animation: trust-meter linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }

  @keyframes trust-meter {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (min-width: 768px) {
    .trust__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .trust__item--featured {
      grid-column: 1 / -1;
      padding: var(--space-8);
    }

    .trust__item--featured .trust__item-title {
      max-width: calc(var(--container-max) / 2);
      font-size: var(--font-size-xl);
    }

    .trust__item--featured .trust__item-text {
      max-width: calc(var(--container-max) / 2);
    }
  }

  @media (min-width: 1024px) {
    .trust__ghost {
      font-size: calc(var(--font-size-2xl) * 3.2);
    }

    .trust__item--featured .trust__ghost {
      font-size: calc(var(--font-size-2xl) * 3.8);
    }

    .trust__list:has(.trust__item:nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .trust__list:has(.trust__item:nth-child(3):last-child) .trust__item--featured {
      grid-column: 1 / span 2;
      grid-row: 1 / span 2;
    }

    .trust__list:has(.trust__item:nth-child(4):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .trust__list:has(.trust__item:nth-child(4):last-child) .trust__item--featured {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>
