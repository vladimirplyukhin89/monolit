---
interface Props {
  eyebrow?: string;
  title: string;
  support: string;
  ctaLabel?: string;
  ctaHref?: string;
  photoAlt?: string;
  /** view-transition-name медиа: морфинг из карточки DirectionChooser */
  transitionName?: string;
}

const {
  eyebrow = 'Ремонт',
  title,
  support,
  ctaLabel = 'Оставить заявку',
  ctaHref = '#lead',
  photoAlt = 'Фото готового ремонта — будет добавлено',
  transitionName,
} = Astro.props;
---

<section class="photo-hero" aria-labelledby="photo-hero-title">
  <div
    class="photo-hero__media"
    role="img"
    aria-label={photoAlt}
    style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
  >
    <span class="photo-hero__media-label">Фото интерьера</span>
  </div>
  <div class="photo-hero__scrim" aria-hidden="true"></div>
  <div class="container photo-hero__content">
    <p class="eyebrow eyebrow--on-inverse">{eyebrow}</p>
    <h1 id="photo-hero-title" class="photo-hero__title">{title}</h1>
    <p class="photo-hero__support">{support}</p>
    <a class="photo-hero__cta" href={ctaHref} data-lead-dialog>{ctaLabel}</a>
  </div>
</section>

<style>
  .photo-hero {
    position: relative;
    min-height: min(80vh, 36rem);
    display: grid;
    align-items: end;
    color: var(--color-on-inverse);
    background: var(--color-bg-inverse);
  }

  .photo-hero__media {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--color-bg-inverse);
    border-bottom: 1px dashed color-mix(in srgb, var(--color-on-inverse) 25%, transparent);
  }

  .photo-hero__media-label {
    position: relative;
    z-index: 1;
    color: color-mix(in srgb, var(--color-on-inverse) 55%, transparent);
    font-size: var(--font-size-base);
  }

  .photo-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-bg-inverse) 88%, transparent) 0%,
      color-mix(in srgb, var(--color-bg-inverse) 35%, transparent) 55%,
      color-mix(in srgb, var(--color-bg-inverse) 20%, transparent) 100%
    );
    pointer-events: none;
  }

  .photo-hero__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-12) var(--space-16);
    max-width: 40rem;
  }

  .photo-hero__title {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-xl);
    font-weight: 500;
    line-height: var(--line-height-tight);
  }

  .photo-hero__support {
    margin: 0 0 var(--space-6);
    color: color-mix(in srgb, var(--color-on-inverse) 78%, transparent);
    font-size: var(--font-size-base);
  }

  .photo-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    text-decoration: none;
    font-weight: 600;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .photo-hero__cta:hover {
    background: var(--color-primary-hover);
  }

  .photo-hero__cta:active {
    background: var(--color-primary-active);
    transform: scale(var(--press-scale));
  }

  @media (min-width: 768px) {
    .photo-hero {
      min-height: min(85vh, 42rem);
    }

    .photo-hero__title {
      font-size: var(--font-size-2xl);
    }

    .photo-hero__content {
      padding-block: var(--space-16);
    }
  }
</style>
