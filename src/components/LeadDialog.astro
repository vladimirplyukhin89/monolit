---
import LeadForm from './LeadForm';
---

<dialog id="lead-dialog" class="dialog" aria-labelledby="lead-dialog-title">
  <div class="dialog__body">
    <div class="dialog__head">
      <div>
        <h2 id="lead-dialog-title" class="dialog__title">Оставить заявку</h2>
        <p class="dialog__text">Перезвоним и согласуем выезд или консультацию.</p>
      </div>
      <button type="button" class="dialog__close" data-dialog-close aria-label="Закрыть">
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <LeadForm client:load variant="dialog" />
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lead-dialog');

  if (dialog instanceof HTMLDialogElement) {
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest('[data-lead-dialog]')) {
        event.preventDefault();
        dialog.showModal();
        return;
      }

      if (target === dialog || target.closest('#lead-dialog [data-dialog-close]')) {
        dialog.close();
      }
    });
  }
</script>
